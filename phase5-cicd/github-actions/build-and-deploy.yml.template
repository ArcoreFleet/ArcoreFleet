# Copy to .github/workflows/build-and-deploy.yml in the APP's own repo
# (not this infra repo) and replace every <PLACEHOLDER>.
#
# Required repo secrets (Settings -> Secrets and variables -> Actions):
#   TS_OAUTH_CLIENT_ID      Tailscale OAuth client ID, scoped to tag:ci
#   TS_OAUTH_CLIENT_SECRET  its secret
#   KUBE_CONFIG_CI          base64 kubeconfig from
#                           phase5-cicd/ci-rbac/generate-ci-kubeconfig.sh
#                           (scoped to just this app's Deployment, not
#                           cluster-admin)

name: Build and deploy

on:
  push:
    branches: [main]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # Runners aren't on the tailnet by default - join it for the
      # duration of this job only. The OAuth client can only ever create
      # devices tagged tag:ci (see Phase 5 README), and Tailscale auto-
      # removes ephemeral devices like this one once the runner exits.
      - name: Join tailnet
        uses: tailscale/github-action@v2
        with:
          oauth-client-id: ${{ secrets.TS_OAUTH_CLIENT_ID }}
          oauth-secret: ${{ secrets.TS_OAUTH_CLIENT_SECRET }}
          tags: tag:ci

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Buildx
        uses: docker/setup-buildx-action@v3
        with:
          driver-opts: network=host # shares the runner's network namespace, so buildkit can reach the tailnet
          buildkitd-config: phase5-buildkitd.toml # copy of buildkitd.toml.template with the real registry IP filled in

      - name: Build and push multi-arch image
        run: |
          docker buildx build \
            --platform linux/amd64,linux/arm64 \
            -t <REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>:${{ github.sha }} \
            -t <REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>:latest \
            --push .

      - name: Set up kubectl
        uses: azure/setup-kubectl@v4

      - name: Deploy to K3s
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBE_CONFIG_CI }}" | base64 -d > ~/.kube/config
          kubectl set image deployment/<APP_NAME> <APP_NAME>=<REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>:${{ github.sha }} -n apps
          kubectl rollout status deployment/<APP_NAME> -n apps --timeout=120s
