# Copy to .github/workflows/build-and-deploy.yml in the APP's own repo
# (not this infra repo) and replace every <PLACEHOLDER>.
#
# Also copy tools/configure-registry-auth.py into the application repository.
# Registry rollout: phase3-data-services/registry/AUTH.md.
# Required repo secrets (Settings -> Secrets and variables -> Actions):
#   REGISTRY_USERNAME      registry login
#   REGISTRY_PASSWORD      registry password
#   TS_OAUTH_CLIENT_ID      Tailscale OAuth client ID, scoped to tag:ci
#   TS_OAUTH_CLIENT_SECRET  its secret
#   KUBE_CONFIG_CI          base64 kubeconfig from
#                           phase5-cicd/ci-rbac/generate-ci-kubeconfig.sh
#                           (scoped to just this app's Deployment, not
#                           cluster-admin)

name: Build and deploy

on:
  push:
    branches: [main]

env:
  IMAGE: <REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    env:
      DOCKER_CONFIG: /tmp/fleet-docker-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      # Runners aren't on the tailnet by default - join it for the
      # duration of this job only. The OAuth client can only ever create
      # devices tagged tag:ci (see Phase 5 README), and Tailscale auto-
      # removes ephemeral devices like this one once the runner exits.
      - name: Join tailnet
        uses: tailscale/github-action@4e4c49acaa9818630ce0bd7a564372c17e33fb4d # v2
        with:
          oauth-client-id: ${{ secrets.TS_OAUTH_CLIENT_ID }}
          oauth-secret: ${{ secrets.TS_OAUTH_CLIENT_SECRET }}
          tags: tag:ci

      - name: Configure registry credentials
        env:
          REGISTRY_USERNAME: ${{ secrets.REGISTRY_USERNAME }}
          REGISTRY_PASSWORD: ${{ secrets.REGISTRY_PASSWORD }}
        run: |
          export REGISTRY="${IMAGE%/*}"
          python3 tools/configure-registry-auth.py

      - name: Set up QEMU
        uses: docker/setup-qemu-action@c7c53464625b32c7a7e944ae62b3e17d2b600130 # v3

      - name: Set up Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
        with:
          driver-opts: network=host # shares the runner's network namespace, so buildkit can reach the tailnet
          buildkitd-config: phase5-buildkitd.toml # copy of buildkitd.toml.template with the real registry IP filled in

      - name: Build and push multi-arch image
        run: |
          docker buildx build \
            --platform linux/amd64,linux/arm64 \
            -t <REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>:${{ github.sha }} \
            -t <REGISTRY_TAILSCALE_IP>:30500/<APP_NAME>:latest \
            --metadata-file "$RUNNER_TEMP/image-metadata.json" --push .

      - name: Select immutable deployment image
        run: |
          digest=$(jq -er '."containerimage.digest" | select(test("^sha256:[0-9a-f]{64}$"))' "$RUNNER_TEMP/image-metadata.json")
          echo "DEPLOY_IMAGE=$IMAGE@$digest" >> "$GITHUB_ENV"

      - name: Set up kubectl
        uses: azure/setup-kubectl@776406bce94f63e41d621b960d78ee25c8b76ede # v4

      - name: Deploy to K3s
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBE_CONFIG_CI }}" | base64 -d > ~/.kube/config
          kubectl set image deployment/<APP_NAME> <APP_NAME>=$DEPLOY_IMAGE -n apps
          kubectl rollout status deployment/<APP_NAME> -n apps --timeout=120s

      - name: Remove registry credentials
        if: always()
        run: rm -f -- "$DOCKER_CONFIG/config.json"
