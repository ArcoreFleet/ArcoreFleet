cloudflare_account_id = "replace-with-your-cloudflare-account-id"

google_client_id     = "replace-with-google-oauth-client-id.apps.googleusercontent.com"
google_client_secret = "replace-with-google-oauth-client-secret"

azure_client_id     = "replace-with-azure-app-registration-client-id"
azure_client_secret = "replace-with-azure-app-registration-client-secret"
azure_tenant_id      = "replace-with-azure-directory-tenant-id"

allowed_emails         = ["admin@example.com"]
allowed_email_domains   = ["example.com"]
