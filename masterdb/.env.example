# Copy to .env (gitignored) and fill in real values.
POSTGRES_USER=masteradmin
POSTGRES_PASSWORD=change-me

# fleet-worker's Tailscale IP - keeps the DB off the LAN/public interfaces.
MASTERDB_BIND=192.0.2.11
MASTERDB_PORT=5432

# Number of data snapshots (.dump) kept per app; older ones are pruned.
SNAPSHOT_KEEP=14

# Oracle ADB wallet password (wallet files go in ./oracle-wallet/) - used by `masterdb sync`.
ORACLE_WALLET_PASSWORD=

# `masterdb check`: alert when a replica hasn't heard from its primary for this long.
CHECK_MAX_LAG_SECONDS=300
# Optional: POST alerts here (e.g. an ntfy.sh topic URL). Empty = log only.
NOTIFY_URL=

# Phase 3 Postgres on fleet-control - used by ../phase4-app-template/provision-app.sh
# to write each new app's replica.env.
ARCORE01_PG_HOST=192.0.2.10
ARCORE01_PG_PORT=30432
ARCORE01_REPL_USER=masterdb_repl
ARCORE01_REPL_PASSWORD=
